# Siparis Ver ve Stok Bildirimi Iste formlarinin api/order.js uzerinden
# gonderim yaptigi ortak webhook URL'i (server-only, client'a gomulmez).
WEBHOOK_URL=

# api/order.js'in Authorization: Bearer <token> header'ini dogrulamak icin
# kullandigi imza anahtari (server-only).
JWT_SECRET=

# JWT_SECRET ile onceden imzalanmis, client bundle'ina gomulen token.
# Uretmek icin: node --env-file=.env scripts/generate-token.mjs
VITE_API_TOKEN=
